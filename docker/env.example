# 文件中转站完整版配置：cp .env.example .env 后按需修改，再执行 docker compose up -d 生效。
# 不建 .env 也能直接启动，所有项都有默认值。

# ---- 数据库 ----
# builtin：内置 PostgreSQL（默认）。密码首次启动时自动生成，保存在 data/secrets/postgres-password。
# sqlite：SQLite，数据库文件为 data/app/app.db，不需要额外服务。
# external：外置 PostgreSQL，同时填写下面的 FT_DATABASE_URL。
# 改为 sqlite 或 external 后，请按 docker-compose.yml 开头的说明删除其中「内置 PostgreSQL」的三处。
# 切换数据库不会自动搬迁数据；从 SQLite 迁到 PostgreSQL 见 README 的「迁移到 PostgreSQL」。
FT_DB_MODE=builtin
# 只用于 external：postgresql://用户:密码@主机:5432/库名，密码里的 @ : / % 等字符要 URL 编码（如 @ 写成 %40）。
# 容器里的 127.0.0.1 指容器自己，数据库在宿主机上时写宿主机的局域网 IP。
FT_DATABASE_URL=

# ---- 端口 ----
# 网盘访问端口
FT_PORT=8000
# 离线下载的 BT 监听端口（TCP/UDP）
FT_ARIA2_BT_PORT=16881

# ---- 运行 ----
FT_WORKERS=4
# 放在 Nginx / Caddy 等 HTTPS 反向代理后面时都改为 true
FT_TRUST_PROXY=false
FT_COOKIE_SECURE=false

# ---- 离线下载 ----
# 选填：额外禁止离线下载访问的 IP/CIDR，逗号分隔；本站地址由后台“站点根地址”自动保护
FT_ARIA2_BLOCKED_NETWORKS=
