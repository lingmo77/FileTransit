# 文件中转站完整版配置。改完后执行 docker compose up -d 生效。
# 本文件里有内置数据库的密码，请和 data/ 一起备份，升级时不要用安装包里的 .env 覆盖。

# ---- 数据库 ----
# 内置数据库（DB_BUILTIN=true）：其余几项都不用填。DB_PASSWORD 首次启动时自动生成并写在这里，
#   之后不要修改或删除，否则网盘连不上数据库。
# 外置 PostgreSQL（DB_BUILTIN=false）：填写 DB_HOST、DB_PORT、DB_NAME、DB_USER、DB_PASSWORD，
#   并按 docker-compose.yml 开头的说明删除其中「内置 PostgreSQL」的两处。库要提前建好，
#   可以先导入 db/init-postgresql.sql（建表并写入管理员和默认设置），不导入时网盘首次启动会自动初始化。
#   容器里的 127.0.0.1 指容器自己，数据库在宿主机上时 DB_HOST 写宿主机的局域网 IP。
#   密码含空格或 # 时用英文双引号括起来。
# SQLite（DB_BUILTIN=false 且 DB_HOST 为空）：数据库文件为 data/app/app.db。
# 切换数据库不会自动搬迁数据；从 SQLite 迁到 PostgreSQL 见 README 的「迁移到 PostgreSQL」。
DB_BUILTIN=true        # true：内置数据库（默认）；false：外置数据库，为空使用sqlite
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# ---- 端口 ----
# 网盘访问端口
FT_PORT=8000
# 离线下载的 BT 监听端口（TCP/UDP）
FT_ARIA2_BT_PORT=16881

# ---- 运行 ----
FT_WORKERS=4
# 放在 Nginx / Caddy 等 HTTPS 反向代理后面时都改为 true
FT_TRUST_PROXY=false
FT_COOKIE_SECURE=false

# ---- 离线下载 ----
# 选填：额外禁止离线下载访问的 IP/CIDR，逗号分隔；本站地址由后台“站点地址”自动保护
FT_ARIA2_BLOCKED_NETWORKS=
