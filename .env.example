# 复制为 .env 后按需修改。所有变量都带 FT_ 前缀。
# 生产环境请至少修改 FT_SECRET_KEY 与 FT_ADMIN_PASSWORD。

# ---- 基础 ----
FT_DEBUG=false
# 运行时数据目录（SQLite + 文件本体），容器里应挂载为卷
FT_DATA_DIR=./data
FT_HOST=0.0.0.0
FT_PORT=8000
FT_WORKERS=4

# ---- 安全 ----
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
FT_SECRET_KEY=dev-insecure-secret-key-please-change-me
FT_SESSION_TTL_HOURS=336
# 走 HTTPS 时设为 true（Cookie 只经加密连接发送）
FT_COOKIE_SECURE=false
# 部署在 Nginx / Caddy 之后时设为 true，否则不信任 X-Forwarded-For
FT_TRUST_PROXY=false

# ---- 上传 / 下载 ----
# 单文件上限的「播种默认值」：只在首次建库时写进 settings 表，
# 之后一律由后台「站点设置 → 单文件大小上限」决定，改这里不影响已建好的库
FT_MAX_UPLOAD_MB=20480
# 过期文件清理间隔（分钟）
FT_CLEANUP_INTERVAL_MINUTES=10

# ---- 首次启动创建的默认管理员（需求 7：admin/admin）----
# 仅在数据库里还没有这个用户时生效；上线后请立刻改密
FT_ADMIN_USERNAME=admin
FT_ADMIN_PASSWORD=admin

# ---- 限流（次数 / 窗口秒数）----
FT_RATE_LIMIT_ENABLED=true
FT_RATE_LIMIT_LOGIN=10
FT_RATE_LIMIT_LOGIN_WINDOW=300
FT_RATE_LIMIT_REGISTER=5
FT_RATE_LIMIT_REGISTER_WINDOW=3600
FT_RATE_LIMIT_RESEND=3
FT_RATE_LIMIT_RESEND_WINDOW=600
FT_RATE_LIMIT_UPLOAD=120
FT_RATE_LIMIT_UPLOAD_WINDOW=3600
