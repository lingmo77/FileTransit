# 复制为 .env 后按需修改。所有变量都带 FT_ 前缀。
# 仅供手动开发配置；生产请运行 install.sh 自动生成密码和密钥，不要复制本模板。

# ---- 基础 ----
FT_DEBUG=false
# 运行时数据目录（SQLite + 文件本体），容器里应挂载为卷
FT_DATA_DIR=./data
FT_HOST=0.0.0.0
FT_PORT=8000
FT_WORKERS=4

# ---- 安全 ----
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
FT_SECRET_KEY=dev-insecure-secret-key-please-change-me
FT_SESSION_TTL_HOURS=336
# 走 HTTPS 时设为 true（Cookie 只经加密连接发送）
FT_COOKIE_SECURE=false
# 部署在 Nginx / Caddy 之后时设为 true，否则不信任 X-Forwarded-For
FT_TRUST_PROXY=false

# ---- 上传 / 下载 ----
# 单文件上限的「播种默认值」：只在首次建库时写进 settings 表，
# 之后一律由后台「站点设置 → 单文件大小上限」决定，改这里不影响已建好的库
FT_MAX_UPLOAD_MB=20480
# 多 worker 共享的接收限制；预算按实际接收字节上限预占，进程退出自动释放
FT_UPLOAD_CONCURRENCY=8
FT_UPLOAD_USER_CONCURRENCY=3
FT_UPLOAD_TEMP_MAX_MB=40960
FT_UPLOAD_IDLE_TIMEOUT_SECONDS=120
# 过期文件清理间隔（分钟）
FT_CLEANUP_INTERVAL_MINUTES=10

# ---- 可选 Aria2 离线下载：标准版无需填写以下配置 ----
# 可选 Aria2 离线下载版的 docker-compose.yml 同时定义网盘和 Aria2；源码中为 docker-compose.aria2.yml。
# 可选 Aria2 离线下载版配置已固定容器内的路径和 RPC 地址；本地开发可按需设置：
# FT_OFFLINE_DIR=./data/offline
# FT_ARIA2_RPC_URL=http://127.0.0.1:6800/jsonrpc
# FT_ARIA2_RPC_SECRET_FILE=./data/offline/control/rpc-secret
# 下载容器首次启动自动生成并持久化 RPC 密钥，无需更换现有 FT_SECRET_KEY。
# 不要把 RPC 6800 映射到公网。
FT_ARIA2_BT_PORT=16881
# 可选离线下载使用本项目适配镜像，不能替换为任意第三方 Aria2 镜像。
FT_ARIA2_IMAGE=ghcr.io/lingmo77/filetransit-aria2:1.4.0
FT_ARIA2_PACKAGE_VERSION=1.37.0+debian-3
# 选填：额外禁止访问的 IP/CIDR，多个用英文逗号分隔，普通部署留空即可。
# 在后台填写“站点根地址”，系统自动解析域名并刷新本站 IP 黑名单。
# 未填写站点地址或解析失败时暂停离线下载，普通文件中转不受影响。
# CDN 隐藏源站等未出现在站点 DNS 中的额外地址可在此补充；修改后重建 aria2。
# 内网、回环、链路本地、Docker 网络、IPv6 非公网范围已由容器出口规则拒绝。
FT_ARIA2_BLOCKED_NETWORKS=
# 做种、全局上下行限速和磁盘预算在管理后台设置，不用环境变量覆盖数据库设置。

# ---- 首次启动创建的默认管理员（需求 7：admin/admin）----
# 仅在数据库里还没有这个用户时生效；上线后请立刻改密
FT_ADMIN_USERNAME=admin
FT_ADMIN_PASSWORD=admin

# 安装器初始化值：只在数据库中缺少对应设置时写入，不覆盖后台设置。
FT_INITIAL_SITE_URL=
FT_INITIAL_OFFLINE_ENABLED=false

# ---- 限流（次数 / 窗口秒数）----
FT_RATE_LIMIT_ENABLED=true
FT_RATE_LIMIT_LOGIN=10
FT_RATE_LIMIT_LOGIN_WINDOW=300
FT_RATE_LIMIT_REGISTER=5
FT_RATE_LIMIT_REGISTER_WINDOW=3600
FT_RATE_LIMIT_RESEND=3
FT_RATE_LIMIT_RESEND_WINDOW=600
FT_RATE_LIMIT_UPLOAD=120
FT_RATE_LIMIT_UPLOAD_WINDOW=3600
