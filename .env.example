# 源码版配置：cp .env.example .env 后按需修改。所有变量都带 FT_ 前缀，都可以不填用默认值。
# （完整版的配置模板是完整版包里的 .env.example。）

# ---- 基础 ----
FT_DEBUG=false
# 运行时数据目录（SQLite 数据库 + 文件本体 + 自动生成的签名密钥）
FT_DATA_DIR=./data
FT_HOST=0.0.0.0
FT_PORT=8000
FT_WORKERS=4

# ---- 数据库 ----
# 源码版没有内置数据库，DB_BUILTIN 保持 false：
#   DB_HOST 为空：使用 SQLite，数据库文件为 数据目录/app.db（默认），不需要额外服务。
#   DB_HOST 填写：使用 PostgreSQL，同时填写 DB_PORT、DB_NAME、DB_USER、DB_PASSWORD。库要提前建好，
#   可以先导入 db/init-postgresql.sql（建表并写入管理员和默认设置），不导入时首次启动会自动初始化。
#   密码含空格或 # 时用英文双引号括起来。
# 切换数据库不会自动搬迁数据；已有 SQLite 站点要先用 python -m app.tools.sqlite_to_postgresql 迁移，
# 见 README 的「迁移到 PostgreSQL」。
DB_BUILTIN=false       # true：内置数据库（仅完整版）；false：外置数据库，为空使用sqlite
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# ---- 安全 ----
# 留空：首次启动随机生成并保存到 数据目录/.secret_key，之后一直沿用。
# 已有站点请保留原值，更换后会话、SMTP 密码和离线任务来源都无法解密。
FT_SECRET_KEY=
FT_SESSION_TTL_HOURS=336
# 走 HTTPS 时设为 true（Cookie 只经加密连接发送）
FT_COOKIE_SECURE=false
# 部署在 Nginx / Caddy 之后时设为 true，否则不信任 X-Forwarded-For
FT_TRUST_PROXY=false

# ---- 首次启动创建的默认管理员 ----
# 只在数据库里还没有管理员时生效；首次登录强制修改密码
FT_ADMIN_USERNAME=admin
FT_ADMIN_PASSWORD=admin

# 首次建库时写入后台设置的初始值，不覆盖已有后台设置
FT_INITIAL_SITE_URL=

# ---- 上传 / 下载 ----
# 单文件上限的「播种默认值」：只在首次建库时写进后台设置，之后以后台为准
FT_MAX_UPLOAD_MB=20480
# 多 worker 共享的接收限制；预算按实际接收字节上限预占，进程退出自动释放
FT_UPLOAD_CONCURRENCY=8
FT_UPLOAD_USER_CONCURRENCY=3
FT_UPLOAD_TEMP_MAX_MB=40960
FT_UPLOAD_IDLE_TIMEOUT_SECONDS=120
# 过期文件清理间隔（分钟）
FT_CLEANUP_INTERVAL_MINUTES=10

# ---- 限流（次数 / 窗口秒数）----
FT_RATE_LIMIT_ENABLED=true
FT_RATE_LIMIT_LOGIN=10
FT_RATE_LIMIT_LOGIN_WINDOW=300
FT_RATE_LIMIT_REGISTER=5
FT_RATE_LIMIT_REGISTER_WINDOW=3600
FT_RATE_LIMIT_RESEND=3
FT_RATE_LIMIT_RESEND_WINDOW=600
FT_RATE_LIMIT_UPLOAD=120
FT_RATE_LIMIT_UPLOAD_WINDOW=3600
